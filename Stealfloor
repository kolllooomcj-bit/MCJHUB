-- ✨ MCJ - Steal Floor 3 (Local Fly Velocity + XZ Lock Fixed)
-- =========================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local flyRunning = false
local storedTransparency = {}
local xzLockParts = {}

-- 🧩 Lưu & chỉnh độ mờ tất cả part
local function setAllPartsTransparency(value)
for _, part in ipairs(workspace:GetDescendants()) do
if part:IsA("BasePart") then
if storedTransparency[part] == nil then
storedTransparency[part] = part.Transparency
end
part.Transparency = value
end
end
end

-- 🧩 Khôi phục lại độ mờ
local function restorePartsTransparency()
for part, original in pairs(storedTransparency) do
if part and part:IsDescendantOf(workspace) then
part.Transparency = original
end
end
storedTransparency = {}
end

-- 🧩 Xóa khung khóa
local function removeXZLock()
for _, p in ipairs(xzLockParts) do
if p and p.Parent then
p:Destroy()
end
end
xzLockParts = {}
end

-- 🧩 Tạo “khung khóa” XZ quanh nhân vật
local function createXZLock(hrp)
removeXZLock()

local size = 6  
local thickness = 1  

local offsets = {  
	Vector3.new(size/2, 0, 0),  
	Vector3.new(-size/2, 0, 0),  
	Vector3.new(0, 0, size/2),  
	Vector3.new(0, 0, -size/2)  
}  

for _, offset in ipairs(offsets) do  
	local wall = Instance.new("Part")  
	wall.Anchored = true  
	wall.CanCollide = true  
	wall.Transparency = 1  
	wall.Size = Vector3.new(  
		math.abs(offset.X) > 0 and thickness or size,  
		10,  
		math.abs(offset.Z) > 0 and thickness or size  
	)  
	wall.CFrame = hrp.CFrame * CFrame.new(offset)  
	wall.Parent = workspace  
	table.insert(xzLockParts, wall)  
end  

-- sàn chống rơi  
local floor = Instance.new("Part")  
floor.Anchored = true  
floor.CanCollide = true  
floor.Transparency = 1  
floor.Size = Vector3.new(size, 1, size)  
floor.CFrame = hrp.CFrame * CFrame.new(0, -3, 0)  
floor.Parent = workspace  
table.insert(xzLockParts, floor)

end

-- 🧩 Tạo GUI
local function createFlyGui()
if player.PlayerGui:FindFirstChild("StealFloor3Gui") then
player.PlayerGui.StealFloor3Gui:Destroy()
end

local gui = Instance.new("ScreenGui")  
gui.Name = "StealFloor3Gui"  
gui.ResetOnSpawn = false  
gui.Parent = player:WaitForChild("PlayerGui")  

local frame = Instance.new("Frame")  
frame.Size = UDim2.new(0, 250, 0, 160)  
frame.Position = UDim2.new(0.65, 0, 0.35, 0)  
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)  
frame.Active = true  
frame.Draggable = true  
frame.Parent = gui  
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)  

local title = Instance.new("TextLabel")  
title.Size = UDim2.new(1, 0, 0, 30)  
title.Text = "Steal Floor 3"  
title.Font = Enum.Font.GothamBold  
title.TextColor3 = Color3.fromRGB(255, 220, 120)  
title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)  
title.TextSize = 18  
title.Parent = frame  
Instance.new("UICorner", title).CornerRadius = UDim.new(0, 8)  

local scroll = Instance.new("ScrollingFrame")  
scroll.Size = UDim2.new(1, 0, 1, -30)  
scroll.Position = UDim2.new(0, 0, 0, 30)  
scroll.CanvasSize = UDim2.new(0, 0, 0, 200)  
scroll.ScrollBarThickness = 6  
