-- Function sử dụng Quantum Cloner
local function useQuantumCloner()
	pcall(function()
		local backpack = player:WaitForChild("Backpack")
		local char = player.Character or player.CharacterAdded:Wait()
		local humanoid = char:WaitForChild("Humanoid")

		local packages = ReplicatedStorage:WaitForChild("Packages")
		local netFolder = packages:WaitForChild("Net")
		local useItemRemote = netFolder:WaitForChild("RE/UseItem")
		local teleportRemote = netFolder:WaitForChild("RE/QuantumCloner/OnTeleport")

		local tool = backpack:FindFirstChild("Quantum Cloner") or char:FindFirstChild("Quantum Cloner")
		if not tool then
			for _, i in ipairs(backpack:GetChildren()) do
				if i:IsA("Tool") then
					tool = i
					break
				end
			end
		end

		if tool and tool.Parent == backpack then
			humanoid:EquipTool(tool)
			task.wait(0.1)
		end

		task.wait(0.1)
		useItemRemote:FireServer()
		task.wait(0.1)
		teleportRemote:FireServer()
	end)
end

clonerBtn.MouseButton1Click:Connect(function()
	useQuantumCloner()
	clonerBtn.BackgroundColor3 = Color3.fromRGB(100,255,100)
	task.delay(0.3,function() clonerBtn.BackgroundColor3 = Color3.fromRGB(255,100,100) end)
end)

--== Nút Aura Bat ==--
local auraBtn = Instance.new("TextButton")
auraBtn.Size = UDim2.new(0.8,0,0,35)
auraBtn.Position = UDim2.new(0.1,0,0.65,0)
auraBtn.Text = "🔘 Aura Bat: OFF"
auraBtn.Font = Enum.Font.GothamBold
auraBtn.TextSize = 18
auraBtn.TextColor3 = Color3.fromRGB(255,255,255)
auraBtn.BackgroundColor3 = Color3.fromRGB(50,50,50)
Instance.new("UICorner", auraBtn).CornerRadius = UDim.new(0,10)
local stroke = Instance.new("UIStroke", auraBtn)
stroke.Thickness = 2
stroke.Color = Color3.fromRGB(80,80,80)
auraBtn.AutoButtonColor = false
auraBtn.Parent = frame

-- Aura logic
local auraActive = false
local spinning = false

local function toggleAura()
	auraActive = not auraActive
	auraBtn.Text = auraActive and "💫 Aura Bat: ON" or "🔘 Aura Bat: OFF"
	auraBtn.BackgroundColor3 = auraActive and Color3.fromRGB(0,170,255) or Color3.fromRGB(50,50,50)
	stroke.Color = auraActive and Color3.fromRGB(0,255,255) or Color3.fromRGB(80,80,80)

	if auraActive and not spinning then
		spinning = true
		task.spawn(function()
			while auraActive do
				local char = player.Character
				if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
					local hrp = char.HumanoidRootPart
					local tool = char:FindFirstChild("Bat") or player.Backpack:FindFirstChild("Bat")

					-- Equip Bat nếu chưa có
					if tool and tool.Parent ~= char then
						char.Humanoid:EquipTool(tool)
					end

					-- Xoay nhanh + dùng tool
					if tool then
						hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(45), 0)
						pcall(function() tool:Activate() end)
					end
				end
				task.wait(0.05)
			end
			spinning = false
		end)
	end
end

-- Hiệu ứng nhấn nút
auraBtn.MouseButton1Down:Connect(function() auraBtn.BackgroundColor3 = Color3.fromRGB(20,20,20) end)
auraBtn.MouseButton1Up:Connect(toggleAura)
