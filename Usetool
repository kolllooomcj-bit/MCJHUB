-- Function sử dụng Quantum Cloner + đổi cơ thể server-side
local function useQuantumCloner()
	local success, err = pcall(function()
		local backpack = LocalPlayer:WaitForChild("Backpack")
		local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid")

		local packages = ReplicatedStorage:WaitForChild("Packages", 5)
		if not packages then return end
		local netFolder = packages:WaitForChild("Net", 5)
		if not netFolder then return end

		local useItemRemote = netFolder:WaitForChild("RE/UseItem", 5)
		local teleportRemote = netFolder:WaitForChild("RE/QuantumCloner/OnTeleport", 5)
		if not useItemRemote or not teleportRemote then return end

		local tool = backpack:FindFirstChild("Quantum Cloner") or character:FindFirstChild("Quantum Cloner")
		if not tool then
			for _, i in ipairs(backpack:GetChildren()) do
				if i:IsA("Tool") then
					tool = i
					break
				end
			end
		end

		if tool and tool.Parent == backpack then
			humanoid:EquipTool(tool)
			task.wait(0.1)
		end

		task.wait(0.1)
		useItemRemote:FireServer()
		task.wait(0.1)
		teleportRemote:FireServer()
	end)

	if not success then
		warn("Quantum Cloner Error:", err)
	end
end

-- Nút nhấn
button.MouseButton1Click:Connect(function()
	useQuantumCloner()
	button.BackgroundColor3 = Color3.fromRGB(100,255,100)
	task.delay(0.3, function()
		button.BackgroundColor3 = Color3.fromRGB(255,100,100)
	end)
end)
