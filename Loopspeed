Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

local timerLabel = Instance.new("TextLabel")
timerLabel.Size = UDim2.new(1, 0, 0, 20)
timerLabel.Position = UDim2.new(0, 0, 1, -20)
timerLabel.BackgroundTransparency = 1
timerLabel.Font = Enum.Font.Gotham
timerLabel.TextSize = 14
timerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
timerLabel.Text = ""
timerLabel.Parent = frame

-- ⚙️ Logic
local looping = false

local function startSpeedLoop()
	if looping then return end
	looping = true

	local humanoid = getHumanoid()
	local originalSpeed = humanoid.WalkSpeed
	local active = true
	local timer = 3

	-- Giao diện đổi màu
	button.Text = "Đang chạy..."
	button.BackgroundColor3 = Color3.fromRGB(255, 70, 70)

	-- Bắt đầu loop giữ tốc độ
	local loopConn
	loopConn = RunService.Heartbeat:Connect(function()
		if not active then
			loopConn:Disconnect()
			return
		end
		if humanoid and humanoid.Parent then
			humanoid.WalkSpeed = 50
		end
	end)

	-- Đếm ngược 5 giây
	while timer > 0 do
		timerLabel.Text = "⏳ Còn " .. timer .. " giây"
		task.wait(1)
		timer -= 1
	end

	-- Dừng loop
	active = false
	humanoid.WalkSpeed = originalSpeed
	timerLabel.Text = "✅ Đã trở lại bình thường"
	button.Text = "Kích Hoạt"
	button.BackgroundColor3 = Color3.fromRGB(50, 150, 250)

	task.wait(1.5)
	timerLabel.Text = ""
	looping = false
end

button.MouseButton1Click:Connect(startSpeedLoop)

-- Reset khi respawn
player.CharacterAdded:Connect(function()
	task.wait(1)
	looping = false
	timerLabel.Text = ""
	button.Text = "Kích Hoạt"
	button.BackgroundColor3 = Color3.fromRGB(50, 150, 250)
end)
