-- ====== Loop Speed Logic ======
local looping = false

local function startSpeedLoop()
	if looping then return end
	looping = true

	local humanoid = getHumanoid()
	if not humanoid then
		looping = false
		return
	end
	local originalSpeed = humanoid.WalkSpeed

	-- UI change
	button.Text = "Đang chạy..."
	button.BackgroundColor3 = Color3.fromRGB(255, 70, 70)

	local active = true
	-- Heartbeat loop to enforce speed
	local loopConn
	loopConn = RunService.Heartbeat:Connect(function()
		if not active then
			loopConn:Disconnect()
			return
		end
		if humanoid and humanoid.Parent then
			humanoid.WalkSpeed = LOOP_WALKSPEED
		end
	end)

	-- countdown
	local remaining = LOOP_DURATION
	while remaining > 0 and active do
		timerLabel.Text = "⏳ Còn " .. tostring(remaining) .. " giây"
		task.wait(1)
		remaining = remaining - 1
	end

	-- cleanup / restore
	active = false
	if humanoid and humanoid.Parent then
		humanoid.WalkSpeed = originalSpeed
	end
	timerLabel.Text = "✅ Đã trở lại bình thường"
	button.Text = "Kích Hoạt"
	button.BackgroundColor3 = Color3.fromRGB(50, 150, 250)

	task.wait(1.5)
	timerLabel.Text = ""
	looping = false
end

button.MouseButton1Click:Connect(startSpeedLoop)

-- ====== Float + Infinite Jump (MCJ Boost) Logic ======
local lp = player
local floatConn, vecForce, att
local infJumpConn = nil
local isBoostOn = false

local function startInfiniteJump()
	if infJumpConn then return end
	infJumpConn = UIS.JumpRequest:Connect(function()
		if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
			-- small upward impulse
			local hrp = lp.Character.HumanoidRootPart
			-- preserve existing horizontal velocity
			hrp.Velocity = Vector3.new(hrp.Velocity.X, 50, hrp.Velocity.Z)
		end
	end)
end

local function stopInfiniteJump()
	if infJumpConn then
		infJumpConn:Disconnect()
		infJumpConn = nil
	end
end

local function startFloat()
	local char = lp.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart

	-- wait until roughly stable vertical velocity (like in provided code)
	task.spawn(function()
		while hrp and math.abs(hrp.Velocity.Y) > 5 do
			task.wait(0.1)
		end
	end)
	task.wait(0.2)

	-- create attachment + vectorforce
	att = Instance.new("Attachment")
	att.Name = "MCJ_Float_Att"
	att.Parent = hrp

	vecForce = Instance.new("VectorForce")
	vecForce.Name = "MCJ_Float_VF"
	vecForce.Attachment0 = att
	-- initial force; will update in RenderStepped
	vecForce.Force = Vector3.new(0, workspace.Gravity * hrp.AssemblyMass * fallMultiplier, 0)
	vecForce.RelativeTo = Enum.ActuatorRelativeTo.World
	vecForce.Parent = hrp

	floatConn = RunService.RenderStepped:Connect(function()
		if vecForce and hrp then
			local vel = hrp.Velocity
			local forceY = workspace.Gravity * hrp.AssemblyMass * fallMultiplier
			local forceXZ = Vector3.new(vel.X * moveMultiplier, 0, vel.Z * moveMultiplier)
			vecForce.Force = Vector3.new(forceXZ.X, forceY, forceXZ.Z)
		end
	end)

	startInfiniteJump()
end

local function stopFloat()
	if floatConn then
		floatConn:Disconnect()
		floatConn = nil
	end
	if vecForce then
		pcall(function() vecForce:Destroy() end)
		vecForce = nil
	end
	if att then
		pcall(function() att:Destroy() end)
		att = nil
	end
	stopInfiniteJump()
end

-- toggle handler for boost button
boostBtn.MouseButton1Click:Connect(function()
	isBoostOn = not isBoostOn
	if isBoostOn then
		boostBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
		boostBtn.TextColor3 = Color3.fromRGB(255,255,255)
		startFloat()
	else
		boostBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		boostBtn.TextColor3 = Color3.fromRGB(0,0,0)
		stopFloat()
	end
end)

-- ====== Cleanup on respawn ======
local function resetStateOnSpawn()
	-- restore walking speed if loop was interrupted
	local ok, humanoid = pcall(getHumanoid)
	if ok and humanoid then
		-- no assumption about original speed here; set to default 16 if Humanoid exists but speed seems wrong
		if humanoid.WalkSpeed ~= 16 then
			-- try to set to 16 (roblox default); this avoids leaving players stuck if script died mid-loop
			humanoid.WalkSpeed = 16
		end
	end

	-- reset UI and flags
	looping = false
	timerLabel.Text = ""
	button.Text = "Kích Hoạt"
	button.BackgroundColor3 = Color3.fromRGB(50, 150, 250)

	-- stop boost effects
	isBoostOn = false
	boostBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	boostBtn.TextColor3 = Color3.fromRGB(0,0,0)
	stopFloat()
end

player.CharacterAdded:Connect(function()
	-- small delay to allow character objects to initialize
	task.wait(1)
	resetStateOnSpawn()
end)

-- Also reset immediately if player already has character
if player.Character then
	-- ensure clean state
	resetStateOnSpawn()
end

-- ====== Extra safety: if script is destroyed, ensure cleanup ======
script.Destroying:Connect(function()
	stopFloat()
	stopInfiniteJump()
end)
