-- ⚙️ Variables
local flying = false
local loopEquipConn
local flyConn
local char, hrp

-- Lấy character & hrp
local function getChar()
    char = player.Character or player.CharacterAdded:Wait()
    hrp = char:WaitForChild("HumanoidRootPart")
end
getChar()
player.CharacterAdded:Connect(function()
    flying = false
    if loopEquipConn then loopEquipConn:Disconnect() loopEquipConn=nil end
    if flyConn then flyConn:Disconnect() flyConn=nil end
    getChar()
end)

-- Find DeliveryHitbox
local function FindDelivery()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return end
	for _, plot in pairs(plots:GetChildren()) do
		local sign = plot:FindFirstChild("PlotSign")
		if sign then
			local yourBase = sign:FindFirstChild("YourBase")
			if yourBase and yourBase.Enabled then
				local hitbox = plot:FindFirstChild("DeliveryHitbox")
				if hitbox then return hitbox end
			end
		end
	end
end

-- Fly loop
local function StartFly()
	if not hrp then return end
	local delivery = FindDelivery()
	if not delivery then return end

	local targetY = hrp.Position.Y

	if flyConn then flyConn:Disconnect() end
	flyConn = RunService.Heartbeat:Connect(function(dt)
		if not flying or not hrp or not hrp.Parent then
			if flyConn then flyConn:Disconnect() flyConn=nil end
			return
		end

		local rootPos = hrp.Position
		local basePos = delivery.Position
		local dir = Vector3.new(basePos.X, rootPos.Y, basePos.Z) - rootPos
		local distXZ = Vector2.new(dir.X, dir.Z).Magnitude
		local distY = math.abs(basePos.Y - rootPos.Y)

		if distXZ <= 5 and distY <= 3 then
			flying = false
			hrp.Velocity = Vector3.zero
			TweenService:Create(toggle, TweenInfo.new(0.25), {BackgroundColor3=Color3.fromRGB(80,80,80)}):Play()
			TweenService:Create(circle, TweenInfo.new(0.25), {Position=UDim2.new(0,1,0,1), BackgroundColor3=Color3.fromRGB(200,0,0)}):Play()
			if loopEquipConn then loopEquipConn:Disconnect() loopEquipConn=nil end
			if flyConn then flyConn:Disconnect() flyConn=nil end
			return
		end

		-- hạ 0.2 studs/s
		targetY -= 0.2*dt
		local vel = dir.Unit*20
		vel = Vector3.new(vel.X,(targetY-rootPos.Y)*5,vel.Z)
		hrp.Velocity = vel
	end)
end

-- Loop auto equip Grapple Hook
local function StartLoopEquip()
	if loopEquipConn then loopEquipConn:Disconnect() loopEquipConn=nil end
	loopEquipConn = RunService.Heartbeat:Connect(function()
		if not char then return end
		local tool = char:FindFirstChild("Grapple Hook") or backpack:FindFirstChild("Grapple Hook")
		if tool and tool.Parent ~= char then
			tool.Parent = char
		end
	end)
end

-- Toggle click
toggle.InputBegan:Connect(function(input)
	if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
		flying = not flying
		if flying then
			TweenService:Create(toggle, TweenInfo.new(0.25), {BackgroundColor3=Color3.fromRGB(0,200,100)}):Play()
			TweenService:Create(circle, TweenInfo.new(0.25), {Position=UDim2.new(1,-21,0,1), BackgroundColor3=Color3.fromRGB(255,255,255)}):Play()
			StartFly()
			StartLoopEquip()
		else
			if flyConn then flyConn:Disconnect() flyConn=nil end
			if loopEquipConn then loopEquipConn:Disconnect() loopEquipConn=nil end
			if hrp then hrp.Velocity=Vector3.zero end
			TweenService:Create(toggle, TweenInfo.new(0.25), {BackgroundColor3=Color3.fromRGB(80,80,80)}):Play()
			TweenService:Create(circle, TweenInfo.new(0.25), {Position=UDim2.new(0,1,0,1), BackgroundColor3=Color3.fromRGB(200,0,0)}):Play()
		end
	end
end)
