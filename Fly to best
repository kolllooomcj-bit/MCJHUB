local function getBasePartForBeam(base)
	if not base then return nil end
	if base.PrimaryPart then return base.PrimaryPart end
	local spawn = base:FindFirstChild("Spawn")
	if spawn and spawn:IsA("BasePart") then return spawn end
	for _,v in pairs(base:GetDescendants()) do
		if v:IsA("BasePart") then return v end
	end
	return nil
end

local currentBasePart -- for beam
RunService.RenderStepped:Connect(function()
	local char = player.Character
	if not char then beam.Enabled = false return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local head = char:FindFirstChild("Head")
	local originPosPart = head or hrp
	if not originPosPart then beam.Enabled = false return end
	if currentBase then
		local tgtPart = getBasePartForBeam(currentBase)
		if tgtPart then
			currentBasePart = tgtPart
			originPart.CFrame = originPosPart.CFrame
			originPart.Parent = char
			if targetAttachment.Parent ~= tgtPart then
				targetAttachment.Parent = tgtPart
				targetAttachment.Position = Vector3.new(0,0,0)
			end
			beam.Enabled = true
		else
			beam.Enabled = false
		end
	else
		beam.Enabled = false
	end
end)

-- ===== FLY V5 =====
local function autoEquipGrapple(flagTable)
	task.spawn(function()
		while flagTable.active do
			local char = player.Character
			if char and not char:FindFirstChild("Grapple Hook") then
				local tool = player.Backpack and player.Backpack:FindFirstChild("Grapple Hook")
				if tool and char:FindFirstChild("Humanoid") then
					char.Humanoid:EquipTool(tool)
				end
			end
			task.wait(0.3)
		end
	end)
end

local function getClosestPart()
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	local hrp = char.HumanoidRootPart
	local closest, dist = nil, math.huge
	for _, v in pairs(Workspace:GetDescendants()) do
		if v:IsA("BasePart") and v.CanCollide and v.Transparency < 1 and not v:IsDescendantOf(char) then
			local d = (v.Position - hrp.Position).Magnitude
			if d < dist and d < 200 then
				dist = d
				closest = v
			end
		end
	end
	return closest
end

local function simulateGrappleClickClosest()
	local char = player.Character
	if not char then return end
	local tool = char:FindFirstChild("Grapple Hook") or (player.Backpack and player.Backpack:FindFirstChild("Grapple Hook"))
	if not tool then return end
	if not char:FindFirstChild("Grapple Hook") and tool and char:FindFirstChild("Humanoid") then
		char.Humanoid:EquipTool(tool)
		task.wait(0.25)
	end
	local equipped = char:FindFirstChild("Grapple Hook")
	if not equipped or not equipped:FindFirstChild("RemoteEvent") then return end
	local remote = equipped.RemoteEvent
	local closestPart = getClosestPart()
	if closestPart then
		pcall(function()
			remote:FireServer(closestPart, closestPart.Position)
		end)
	end
end

local function flyToPosition(targetPos)
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")
	if not hrp then return end
	local startY = hrp.Position.Y
	local startTime = tick()
	local duration = 2

	task.spawn(function()
		local t = 0
		while tick() - startTime < duration and beam do
			t += RunService.RenderStepped:Wait() * 0.6
			local c = Color3.fromHSV(t % 1, 1, 1)
			beam.Color = ColorSequence.new(c)
		end
	end)

	local conn
	conn = RunService.Heartbeat:Connect(function()
		if not hrp then conn:Disconnect() return end
		local elapsed = tick() - startTime
		if elapsed >= duration then
			hrp.Velocity = Vector3.zero
			conn:Disconnect()
			return
		end
		local dir = (Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z) - hrp.Position)
		if dir.Magnitude > 0 then dir = dir.Unit end
		local progress = math.clamp(elapsed / duration, 0, 1)
		local desiredY = startY + progress * 200
		local vel = Vector3.new(dir.X, 0, dir.Z) * 250 + Vector3.new(0, (desiredY - hrp.Position.Y) * 8, 0)
		hrp.Velocity = vel
	end)

	task.wait(0.15)
	simulateGrappleClickClosest()

	task.wait(duration)
	if conn then conn:Disconnect() end
	hrp.Velocity = Vector3.zero
end

-- Remote for UseItem (will be called with arg 0 when starting fly)
local UseItemRemote
pcall(function()
	UseItemRemote = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Net"):WaitForChild("RE/UseItem")
end)

flyButton.MouseButton1Click:Connect(function()
	local bestBase = select(1, findBestBrainrot())
	if not bestBase then return end
	local tgtPart = getBasePartForBeam(bestBase) or bestBase
	local targetPos = tgtPart.Position

	-- start auto-equip loop
	local flag = {active = true}
	autoEquipGrapple(flag)

	-- call UseItem with arg 0 right when fly starts (wrapped in pcall)
	task.spawn(function()
		local args = {0}
		if UseItemRemote then
			pcall(function()
				UseItemRemote:FireServer(unpack(args))
			end)
		end
	end)

	-- enable beam and fly
	currentBase = bestBase
	beam.Enabled = true

	-- fly above target
	local flyTarget = (tgtPart and tgtPart.Position) and (tgtPart.Position + Vector3.new(0, 30, 0)) or (bestBase.PrimaryPart and bestBase.PrimaryPart.Position + Vector3.new(0,10,0)) or (bestBase:GetModelCFrame().p + Vector3.new(0,30,0))
	flyToPosition(flyTarget)

	-- stop auto-equip loop
	flag.active = false

	-- cleanup
	beam.Enabled = false
	if currentGui and currentGui.Parent then currentGui:Destroy() end
	currentGui = nil
	currentBase = nil
end)
