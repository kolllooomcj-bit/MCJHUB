-- ===== HELPER FUNCTIONS (vẫn giữ y nguyên) =====
local function extractNumber(str)
    if not str or type(str) ~= "string" then return 0 end
    local s = str:match("%$?%s*([%d%,%.%s%a]+)")
    if not s then return 0 end
    s = s:gsub("%s",""):gsub(",","")
    local mult = 1
    if s:lower():find("k") then mult = 1e3; s = s:gsub("[kK]","") end
    if s:lower():find("m") then mult = 1e6; s = s:gsub("[mM]","") end
    if s:lower():find("b") then mult = 1e9; s = s:gsub("[bB]","") end
    return (tonumber(s) or 0) * mult
end

local function getAllOverheads()
    local list = {}
    local Plots = Workspace:FindFirstChild("Plots")
    if not Plots then return list end
    for _, plot in pairs(Plots:GetChildren()) do
        local pods = plot:FindFirstChild("AnimalPodiums")
        if pods then
            for _, pod in pairs(pods:GetChildren()) do
                local base = pod:FindFirstChild("Base")
                if base and base:FindFirstChild("Spawn") then
                    local att = base.Spawn:FindFirstChild("Attachment")
                    if att and att:FindFirstChild("AnimalOverhead") then
                        table.insert(list, att.AnimalOverhead)
                    end
                end
            end
        end
    end
    return list
end

local function findBestAnimal()
    local bestValue = -math.huge
    local bestBase = nil
    local bestOverhead = nil
    local bestColor = nil
    local isRainbow = false

    for _, overhead in ipairs(getAllOverheads()) do
        if overhead then
            local base = overhead.Parent and overhead.Parent.Parent and overhead.Parent.Parent.Parent
            local generation = overhead:FindFirstChild("Generation")
            if base and generation then
                local value = extractNumber(tostring(generation.Text))
                if value > bestValue then
                    bestValue = value
                    bestBase = base
                    bestOverhead = overhead
                end
            end
        end
    end

    return bestBase, bestOverhead
end

-- ===== GRAPPLE TOOL LOGIC =====
local function findGrappleHook()
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")
    if character then
        local grapple = character:FindFirstChild("Grapple Hook")
        if grapple then return grapple end
    end
    if backpack then
        local grapple = backpack:FindFirstChild("Grapple Hook")
        if grapple then return grapple end
    end
    return nil
end

local function equipAndUseGrapple()
    local grapple = findGrappleHook()
    if not grapple then
        warn("❌ Không tìm thấy Grapple Hook")
        return false
    end
    local character = player.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end

    if grapple.Parent ~= character then
        pcall(function() humanoid:EquipTool(grapple) end)
        task.wait(0.35)
    end

    pcall(function()
        local remote = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Net"):WaitForChild("RE/UseItem")
        remote:FireServer(0)
    end)

    return true
end

local function safeGetBasePosition(base)
    if not base then return nil end
    if base.PrimaryPart and base.PrimaryPart:IsA("BasePart") then
        return base.PrimaryPart.Position
    end
    local ok, cf = pcall(function() return base:GetModelCFrame() end)
    if ok and cf then
        return cf.Position
    end
    local anyPart = base:FindFirstChildWhichIsA("BasePart", true)
    if anyPart then return anyPart.Position end
    return nil
end

-- ===== FLY MAIN =====
local function startFlying()
    if flyConnection then flyConnection:Disconnect() end

    local base = findBestAnimal()
    if not base then return end

    local basePos = safeGetBasePosition(base)
    if not basePos then return end

    isFlying = true
    stopTimerCancel = false
    equipAndUseGrapple()

    local targetPosition = basePos + Vector3.new(0, 50, 0)

    stopTimerThread = task.spawn(function()
        task.wait(3)
        if isFlying and not stopTimerCancel then
            pcall(stopFlying)
        end
    end)

    flyConnection = RunService.Heartbeat:Connect(function()
        if not isFlying or not flyEnabled then return end

        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local dir = targetPosition - hrp.Position
        local dist = dir.Magnitude

        if dist > 5 then
            hrp.Velocity = dir.Unit * 200
        else
            hrp.Velocity = Vector3.new(0,0,0)
            isFlying = false
        end
    end)
end

function stopFlying()
    isFlying = false
    stopTimerCancel = true
    if flyConnection then flyConnection:Disconnect() end
end

local function toggleFly(state)
    flyEnabled = state

    if state then
        TweenService:Create(flyToggle, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 200, 100)}):Play()
        TweenService:Create(flyCircle, TweenInfo.new(0.2), {
            Position = UDim2.new(1, -26, 0, 2),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()
        pcall(startFlying)
    else
        TweenService:Create(flyToggle, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80,80,80)}):Play()
        TweenService:Create(flyCircle, TweenInfo.new(0.2), {
            Position = UDim2.new(0,2,0,2),
            BackgroundColor3 = Color3.fromRGB(200,0,0)
        }):Play()
        pcall(stopFlying)
    end
end

flyToggle.MouseButton1Click:Connect(function()
