-- ===== Helper funcs =====
local function extractNumber(str)
	if not str then return 0 end
	local numberStr = str:match("%$(.-)/s")
	if not numberStr then
		local anyn = str:match("(%d+)")
		return tonumber(anyn) or 0
	end
	numberStr = numberStr:gsub("%s","")
	local mult = 1
	if numberStr:lower():find("k") then mult = 1e3; numberStr = numberStr:gsub("[kK]","")
	elseif numberStr:lower():find("m") then mult = 1e6; numberStr = numberStr:gsub("[mM]","")
	elseif numberStr:lower():find("b") then mult = 1e9; numberStr = numberStr:gsub("[bB]","")
	end
	return (tonumber(numberStr) or 0) * mult
end

local function getAllOverheads()
	local list = {}
	local Plots = Workspace:FindFirstChild("Plots")
	if not Plots then return list end
	for _, plot in pairs(Plots:GetChildren()) do
		local pods = plot:FindFirstChild("AnimalPodiums")
		if pods then
			for _, pod in pairs(pods:GetChildren()) do
				local base = pod:FindFirstChild("Base")
				if base and base:FindFirstChild("Spawn") then
					local att = base.Spawn:FindFirstChild("Attachment")
					if att and att:FindFirstChild("AnimalOverhead") then
						table.insert(list, att.AnimalOverhead)
					end
				end
			end
		end
	end
	return list
end

local function createStatGui(base, overhead)
	if base:FindFirstChild("StatGui") then base.StatGui:Destroy() end
	local gui2 = Instance.new("BillboardGui", base)
	gui2.Name = "StatGui"
	gui2.Size = UDim2.new(0,220,0,70)
	gui2.StudsOffset = Vector3.new(0,3.8,0)
	gui2.AlwaysOnTop = true

	local frame2 = Instance.new("Frame", gui2)  
	frame2.Size = UDim2.new(1,0,1,0)  
	frame2.BackgroundColor3 = Color3.fromRGB(18,18,18)  
	frame2.BackgroundTransparency = 0.2  
	frame2.BorderSizePixel = 0  
	Instance.new("UICorner", frame2).CornerRadius = UDim.new(0,10)  

	local layout = Instance.new("UIListLayout", frame2)  
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center  
	layout.VerticalAlignment = Enum.VerticalAlignment.Center  
	layout.Padding = UDim.new(0,2)  

	local function makeLabel(txt, color)  
		local l = Instance.new("TextLabel", frame2)  
		l.Size = UDim2.new(1, -8, 0, 16)  
		l.BackgroundTransparency = 1  
		l.Font = Enum.Font.GothamBold  
		l.TextScaled = true  
		l.Text = txt  
		l.TextColor3 = color or Color3.new(1,1,1)  
		return l  
	end  

	local nameTxt = overhead:FindFirstChild("DisplayName") and overhead.DisplayName.Text or "Unknown"  
	local genTxt = overhead:FindFirstChild("Generation") and overhead.Generation.Text or "0"  
	local mutTxt = overhead:FindFirstChild("Mutation") and overhead.Mutation.Text or "Default"  
	local rarTxt = overhead:FindFirstChild("Rarity") and overhead.Rarity.Text or "None"  

	local color = mutationColors[mutTxt] or Color3.new(1,1,1)  
	local isRainbow = (mutTxt == "Rainbow")  

	local n1 = makeLabel(nameTxt, color)  
	local n2 = makeLabel(genTxt, color)  
	local n3 = makeLabel(mutTxt, color)  
	local n4 = makeLabel(rarTxt, color)  

	if isRainbow then  
		task.spawn(function()  
			local t = 0  
			while gui2.Parent do  
				t += RunService.RenderStepped:Wait() * 0.2  
				local c = Color3.fromHSV(t%1,1,1)  
				n1.TextColor3 = c; n2.TextColor3 = c; n3.TextColor3 = c; n4.TextColor3 = c  
			end  
		end)  
	end  
	return gui2
end

local function findBestBrainrot()
	local bestVal = -math.huge
	local bestBase = nil
	local bestOverhead = nil
	local bestColor, bestLabels, bestRainbow
	for _, oh in pairs(getAllOverheads()) do  
		local base = oh.Parent and oh.Parent.Parent and oh.Parent.Parent.Parent  
		local gen = oh:FindFirstChild("Generation")  
		if base and gen then  
			local val = extractNumber(gen.Text)  
			if val > bestVal then  
				bestVal = val  
				bestBase = base  
				bestOverhead = oh  
				local mut = oh:FindFirstChild("Mutation")  
				local mtxt = mut and mut.Text or "Default"  
				bestColor = mutationColors[mtxt] or Color3.new(1,1,1)  
				bestLabels = {  
					DisplayName = oh:FindFirstChild("DisplayName") and oh.DisplayName.Text or "Unknown",  
					Generation = gen.Text,  
					Mutation = mtxt,  
					Rarity = oh:FindFirstChild("Rarity") and oh.Rarity.Text or "None"  
				}  
				bestRainbow = (mtxt == "Rainbow")  
			end  
		end  
	end  
	return bestBase, bestOverhead, bestLabels, bestColor, bestRainbow
end

-- ===== ESP =====
local espTask
local function startESP()
	if espTask then return end
	espTask = task.spawn(function()
		while brainrotEspEnabled do
			local base, overhead, labels, color, rainbow = findBestBrainrot()
			if base then
				if currentGui and currentGui.Parent then currentGui:Destroy() end
				currentBase = base
				currentGui = createStatGui(base, overhead)
			else
				if currentGui and currentGui.Parent then currentGui:Destroy() end
				currentBase = nil
				currentGui = nil
			end
			task.wait(1)
		end
		espTask = nil
	end)
end

local function stopESP()
	brainrotEspEnabled = false
	if currentGui and currentGui.Parent then currentGui:Destroy() end
	currentGui = nil
	currentBase = nil
end

local function setESP(state)
	brainrotEspEnabled = state
	if state then
		TweenService:Create(toggle, TweenInfo.new(0.18), {BackgroundColor3 = Color3.fromRGB(0,200,100)}):Play()
		TweenService:Create(circle, TweenInfo.new(0.18), {Position = UDim2.new(1,-28,0,2), BackgroundColor3 = Color3.fromRGB(255,255,255)}):Play()
		startESP()
	else
		TweenService:Create(toggle, TweenInfo.new(0.18), {BackgroundColor3 = Color3.fromRGB(80,80,80)}):Play()
		TweenService:Create(circle, TweenInfo.new(0.18), {Position = UDim2.new(0,2,0,2), BackgroundColor3 = Color3.fromRGB(200,0,0)}):Play()
		stopESP()
	end
end

