-- 🕶️ MCJ Xray Base GUI

local Players = game:GetService("Players")

local player = Players.LocalPlayer

local RunService = game:GetService("RunService")

local isXrayOn = false

local originalProperties = {} -- lưu Material & Transparency gốc

-- Toggle function

local function toggleXray()

	isXrayOn = not isXrayOn	for _, obj in pairs(workspace:GetDescendants()) do

		if obj:IsA("BasePart") and obj.Name == "structure base home" then

			if isXrayOn then

				if not originalProperties[obj] then

					originalProperties[obj] = {

						Material = obj.Material,

						Transparency = obj.Transparency

					}

				end

				obj.Transparency = 0.9

				obj.Material = Enum.Material.Neon

			else

				if originalProperties[obj] then

					obj.Material = originalProperties[obj].Material

					obj.Transparency = originalProperties[obj].Transparency

					originalProperties[obj] = nil

				end

			end

		end

	end

end

